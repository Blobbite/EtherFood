{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "name",
    "version",
    "description",
    "python",
    "dependencies",
    "files",
    "steps",
    "flows"
  ],
  "properties": {
    "contract": {
      "const": "studio-tool-package-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "python": {
      "type": "string",
      "pattern": "^3\\.[0-9]{1,2}$"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*==[A-Za-z0-9_.+\\-]+$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^(?!\\.)(?!.*(?:^|/)\\.)(?!.*//)[^\\\\:\\u0000]+[^/]$"
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/flow"
      }
    }
  },
  "title": "Versioniertes Werkzeugpaket mit Python-Mikrobausteinen",
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "image",
            "spritesheet",
            "gif",
            "html",
            "json",
            "file"
          ]
        },
        "multiple": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "publish": {
          "type": "boolean"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!\\.)(?!.*(?:^|/)\\.)(?!.*//)[^\\\\:\\u0000]+[^/]$"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "default"
      ],
      "properties": {
        "type": {
          "enum": [
            "number",
            "integer",
            "boolean",
            "string",
            "choice",
            "resource"
          ]
        },
        "default": {
          "type": [
            "number",
            "boolean",
            "string"
          ]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "choice_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "bindings": {
          "type": "object"
        },
        "visible_if": {
          "type": "object"
        },
        "disabled_if": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "number",
                  "integer"
                ]
              }
            }
          },
          "then": {
            "required": [
              "minimum",
              "maximum"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "source",
        "entry_point",
        "execution",
        "capabilities",
        "parameters",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!\\.)(?!.*(?:^|/)\\.)(?!.*//)[^\\\\:\\u0000]+[^/]$"
        },
        "entry_point": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "execution": {
          "enum": [
            "map",
            "collect"
          ]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "animated",
              "directional",
              "supports_materials",
              "static_image",
              "package_member"
            ]
          }
        },
        "parameters": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "inputs": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/port"
          },
          "minProperties": 1
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "recipe"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string"
        },
        "recipe": {
          "$ref": "pipeline-recipe-v2.json"
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "steps": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "flows": {
          "minItems": 1
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etherfood.local/schemas/asset-studio/tool-package-v1.json"
}
