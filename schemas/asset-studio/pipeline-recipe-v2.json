{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etherfood.local/schemas/asset-studio/pipeline-recipe-v2.json",
  "title": "Ablauf aus versionierten Python-Bausteinen und Teilabläufen",
  "description": "Semantische Prüfungen (Zyklen, Porttypen, Ressourcen und Projektprofile) erfolgen zusätzlich im Studio-Dienst.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "category",
    "enabled",
    "steps",
    "connections",
    "profiles",
    "capabilities",
    "resources",
    "overridable",
    "legacy_unresolved",
    "outputs"
  ],
  "properties": {
    "contract": {
      "const": "studio-pipeline-v2"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "enabled": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 0
    },
    "capabilities": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "animated",
          "directional",
          "supports_materials",
          "static_image",
          "package_member"
        ]
      }
    },
    "resources": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_-]{1,80}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resource"
      }
    },
    "overridable": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,160}\\.[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "legacy_unresolved": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 0,
        "maxLength": 512
      }
    },
    "outputs": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/output"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operation",
        "enabled",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "operation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9_:-]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "integer",
              "number"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "source"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        }
      ]
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "out",
        "to",
        "in"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "out": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "in": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "length",
        "name"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/\\\\:\\u0000]+$"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "node",
        "port"
      ],
      "properties": {
        "type": {
          "enum": [
            "image",
            "spritesheet",
            "gif",
            "html",
            "json",
            "file"
          ]
        },
        "multiple": {
          "type": "boolean"
        },
        "publish": {
          "type": "boolean"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!\\.)(?!.*(?:^|/)\\.)(?!.*//)[^\\\\:\\u0000]+[^/]$"
        },
        "label": {
          "type": "string"
        },
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "port": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    }
  }
}
