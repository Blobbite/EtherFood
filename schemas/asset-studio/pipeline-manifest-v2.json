          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "default",
            "choices"
          ],
          "properties": {
            "type": {
              "const": "choice"
            },
            "default": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "choices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "label": {
              "type": "string",
