          "required": [
            "type",
            "default",
            "minimum",
            "maximum"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "default": {
              "type": "integer",
              "minimum": -1000000000000,
              "maximum": 1000000000000
            },
            "minimum": {
              "type": "integer",
              "minimum": -1000000000000,
              "maximum": 1000000000000
            },
            "maximum": {
              "type": "integer",
              "minimum": -1000000000000,
              "maximum": 1000000000000
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "visible_if": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 32,
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            },
            "disabled_if": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 32,
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "default"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "default": {
              "type": "boolean"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "description": {
              "type": "string",
