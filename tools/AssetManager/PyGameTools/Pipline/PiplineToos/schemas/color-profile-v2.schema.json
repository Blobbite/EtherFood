{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PyImg color profile v2",
  "type": "object",
  "required": [
    "format",
    "version",
    "references",
    "sampling",
    "preview_reference"
  ],
  "properties": {
    "format": {
      "enum": [
        "pyimg-reference-colors",
        "pyimg-fixed-palette",
        "pyimg-material-colors"
      ]
    },
    "version": {
      "const": 2
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_revision",
          "path",
          "pose",
          "direction",
          "sha256",
          "size",
          "grid",
          "frames"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pose": {
            "type": [
              "string",
              "null"
            ]
          },
          "direction": {
            "enum": [
              null,
              "N",
              "NO",
              "O",
              "SO",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "grid": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        }
      }
    },
    "sampling": {
      "const": "equal_reference_and_frame_weight; original_RGB; alpha_weighted"
    },
    "preview_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "method": {
      "const": "Lab_D65_chroma_projection_smooth_lut_v1"
    },
    "color_space": {
      "const": "sRGB"
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "pixel_palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "colors"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "colors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": "pyimg-reference-colors"
          }
        }
      },
      "then": {
        "required": [
          "method",
          "colors",
          "pixel_palette"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "pyimg-fixed-palette"
          }
        }
      },
      "then": {
        "required": [
          "color_space",
          "colors"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": "pyimg-material-colors"
          }
        }
      },
      "then": {
        "required": [
          "color_space",
          "materials"
        ]
      }
    }
  ]
}
