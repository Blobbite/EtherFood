{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PyImg explicit reference selection v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "references",
    "sampling",
    "preview_reference"
  ],
  "properties": {
    "format": {
      "const": "pyimg-reference-selection"
    },
    "version": {
      "const": 1
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_revision",
          "path",
          "pose",
          "direction",
          "sha256",
          "size",
          "grid",
          "frames"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pose": {
            "type": [
              "string",
              "null"
            ]
          },
          "direction": {
            "enum": [
              null,
              "N",
              "NO",
              "O",
              "SO",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "grid": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "frames": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          }
        }
      }
    },
    "sampling": {
      "const": "equal_reference_and_frame_weight; original_RGB; alpha_weighted"
    },
    "preview_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "additionalProperties": false
}
