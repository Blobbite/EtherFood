[gd_resource type="Resource" load_steps=21 format=3]

[ext_resource type="Script" path="res://scenes/dev/portal_lab/test_room_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scenes/dev/portal_lab/test_room_definition.gd" id="2_definition"]
[ext_resource type="PackedScene" path="res://scenes/dev/portal_lab/rooms/lamp_room.tscn" id="scene_lamps"]
[ext_resource type="PackedScene" path="res://scenes/dev/portal_lab/rooms/sprite_room.tscn" id="scene_sprites"]
[ext_resource type="PackedScene" path="res://scenes/dev/portal_lab/rooms/monster_room.tscn" id="scene_monsters"]
[ext_resource type="PackedScene" path="res://scenes/dev/portal_lab/rooms/shader_room.tscn" id="scene_shaders"]
[ext_resource type="PackedScene" path="res://scenes/dev/portal_lab/rooms/object_room.tscn" id="scene_objects"]
[ext_resource type="PackedScene" path="res://scenes/dev/portal_lab/rooms/particle_room.tscn" id="scene_particles"]
[ext_resource type="PackedScene" path="res://scenes/dev/portal_lab/rooms/fog_room.tscn" id="scene_fog"]
[ext_resource type="PackedScene" path="res://scenes/dev/portal_lab/rooms/day_night_room.tscn" id="scene_day_night"]
[ext_resource type="PackedScene" path="res://scenes/dev/portal_lab/rooms/world_state_room.tscn" id="scene_world_state"]

[sub_resource type="Resource" id="room_lamps"]
script = ExtResource("2_definition")
room_id = &"lamps"
title = "Lampenraum"
description = "Lichtstärken und Beleuchtung prüfen."
scene = ExtResource("scene_lamps")

[sub_resource type="Resource" id="room_sprites"]
script = ExtResource("2_definition")
room_id = &"sprites"
title = "Sprite-Testraum"
description = "Figuren, Posen und Grafikvarianten vergleichen."
scene = ExtResource("scene_sprites")

[sub_resource type="Resource" id="room_monsters"]
script = ExtResource("2_definition")
room_id = &"monsters"
title = "Monsterraum"
description = "Platzhalter für Gegner in drei Größen."
scene = ExtResource("scene_monsters")

[sub_resource type="Resource" id="room_shaders"]
script = ExtResource("2_definition")
room_id = &"shaders"
title = "Shaderraum"
description = "Statische Vergleichsflächen für kommende Shader."
scene = ExtResource("scene_shaders")

[sub_resource type="Resource" id="room_objects"]
script = ExtResource("2_definition")
room_id = &"objects"
title = "Objekt-Testraum"
description = "Objekte, Kollisionen, Größen und Bodenraster vergleichen."
scene = ExtResource("scene_objects")

[sub_resource type="Resource" id="room_particles"]
script = ExtResource("2_definition")
room_id = &"particles"
title = "Partikel-Testraum"
description = "Drei getrennte Partikelproben starten und stoppen."
scene = ExtResource("scene_particles")

[sub_resource type="Resource" id="room_fog"]
script = ExtResource("2_definition")
room_id = &"fog"
title = "Nebelraum"
description = "Nebelvarianten unter F5 → Welt & Atmosphäre vergleichen."
scene = ExtResource("scene_fog")

[sub_resource type="Resource" id="room_day_night"]
script = ExtResource("2_definition")
room_id = &"day_night"
title = "Tag-Nacht-Raum"
description = "Hell, dunkel und einen vollständigen Tageszyklus prüfen."
scene = ExtResource("scene_day_night")

[sub_resource type="Resource" id="room_world_state"]
script = ExtResource("2_definition")
room_id = &"world_state"
title = "Weltzustandsraum"
description = "Aufgebaut und zerstört unter F5 → Welt & Atmosphäre vergleichen."
scene = ExtResource("scene_world_state")

[resource]
script = ExtResource("1_catalog")
rooms = Array[ExtResource("2_definition")]([SubResource("room_lamps"), SubResource("room_sprites"), SubResource("room_monsters"), SubResource("room_shaders"), SubResource("room_objects"), SubResource("room_particles"), SubResource("room_fog"), SubResource("room_day_night"), SubResource("room_world_state")])
